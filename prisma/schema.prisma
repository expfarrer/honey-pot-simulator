generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HoneypotType {
  SSH
  HTTP
  WORDPRESS
  REDIS
  MONGODB
  IOT
}

enum HoneypotStatus {
  RUNNING
  PAUSED
  STOPPED
  ERROR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActorType {
  BOT
  HUMAN
  ADVANCED
  UNKNOWN
}

enum EventType {
  CONNECTION
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  LOGIN_FAILED
  COMMAND
  FILE_UPLOAD
  FILE_DOWNLOAD
  DISCONNECT
  PORT_FORWARD
}

enum ChainType {
  FINGERPRINT
  PAYLOAD_EXECUTION
  PERSISTENCE
  ANTI_FORENSICS
  IOT_BOT
}

// ── Core models ───────────────────────────────────────────

model Honeypot {
  id            String         @id @default(cuid())
  name          String
  type          HoneypotType   @default(SSH)
  status        HoneypotStatus @default(STOPPED)
  publicPort    Int            @unique
  configJson    Json           @default("{}")
  dockerService String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  attackChains  AttackChain[]

  @@map("honeypots")
}

model Session {
  id          String    @id @default(cuid())
  honeypotId  String
  sourceIp    String
  sourcePort  Int?
  country     String?
  asn         String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  riskLevel   RiskLevel @default(LOW)
  actorType   ActorType @default(BOT)
  sessionRef  String?   @unique

  honeypot     Honeypot      @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  events       Event[]
  attackChains AttackChain[]

  @@index([honeypotId])
  @@index([sourceIp])
  @@index([startedAt])
  @@index([riskLevel])
  @@map("sessions")
}

model Event {
  id        String    @id @default(cuid())
  sessionId String
  eventType EventType
  command   String?
  username  String?
  password  String?
  rawJson   Json
  createdAt DateTime  @default(now())

  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("events")
}

model AuditLog {
  id         String    @id @default(cuid())
  honeypotId String?
  action     String
  actorIp    String?
  details    Json      @default("{}")
  createdAt  DateTime  @default(now())

  honeypot   Honeypot? @relation(fields: [honeypotId], references: [id], onDelete: SetNull)

  @@index([honeypotId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Intelligence models ───────────────────────────────────

model CommandPattern {
  id                String    @id @default(cuid())
  command           String    @db.Text
  normalizedCommand String    @unique @db.Text
  category          String
  count             Int       @default(1)
  uniqueIps         Int       @default(1)
  seenIpsJson       Json      @default("[]")
  firstSeen         DateTime  @default(now())
  lastSeen          DateTime  @default(now())
  riskLevel         RiskLevel @default(LOW)

  @@index([category])
  @@index([riskLevel])
  @@index([count])
  @@map("command_patterns")
}

model CredentialPattern {
  id                  String   @id @default(cuid())
  username            String
  passwordHash        String
  usernamePasswordKey String   @unique
  count               Int      @default(1)
  uniqueIps           Int      @default(1)
  seenIpsJson         Json     @default("[]")
  firstSeen           DateTime @default(now())
  lastSeen            DateTime @default(now())

  @@index([username])
  @@index([count])
  @@map("credential_patterns")
}

model ActorProfile {
  id               String    @id @default(cuid())
  sourceIp         String    @unique
  actorType        ActorType @default(UNKNOWN)
  riskScore        Int       @default(0)
  totalSessions    Int       @default(0)
  totalEvents      Int       @default(0)
  firstSeen        DateTime  @default(now())
  lastSeen         DateTime  @default(now())
  topCommandsJson  Json      @default("[]")
  topUsernamesJson Json      @default("[]")
  notes            String?

  @@index([actorType])
  @@index([riskScore])
  @@map("actor_profiles")
}

model AttackChain {
  id         String    @id @default(cuid())
  sessionId  String
  honeypotId String
  chainType  ChainType
  severity   RiskLevel
  stepsJson  Json
  confidence Int       @default(0)
  createdAt  DateTime  @default(now())

  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  honeypot   Honeypot  @relation(fields: [honeypotId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chainType])
  @@index([honeypotId])
  @@index([severity])
  @@index([createdAt])
  @@map("attack_chains")
}
